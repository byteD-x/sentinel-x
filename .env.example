# Sentinel-X development template. Copy values into an ignored local env file.
# Empty sensitive values are intentional. Never commit real credentials.

# Runtime profile
SENTINEL_PROFILE=light
SENTINEL_ENVIRONMENT=local-demo
SENTINEL_LOG_LEVEL=INFO
SENTINEL_ACTIONS_ENABLED=false
SENTINEL_KILL_SWITCH=true

# Public local endpoints
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8000
WEB_CONSOLE_PORT=5173
SENTINEL_EVAL_ARCHIVE_DIR=evals/results
SENTINEL_EVAL_ARCHIVE_MAX_BYTES=2097152

# Domain state and workflow
DATABASE_URL=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=sentinel-local
TEMPORAL_TASK_QUEUE=sentinel-incidents

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
LOKI_BASE_URL=http://127.0.0.1:3100
TEMPO_BASE_URL=http://127.0.0.1:3200
GRAFANA_BASE_URL=http://127.0.0.1:3000
SLO_POLICY_VERSION=slo@dev

# LLM provider. Required only when the investigator is enabled.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_TOKENS=60000
LLM_MAX_OUTPUT_TOKENS=8000
PROMPT_BUNDLE_VERSION=prompt@dev

# Safety and internal identity
POLICY_VERSION=policy@dev
ACTION_GATEWAY_URL=http://action-gateway.sentinel-system.svc.cluster.local:8080
ACTION_GATEWAY_AUDIENCE=sentinel-action-gateway
# 留空时 Action Gateway 拒绝所有 R1；light 默认 kill switch 开启。
SENTINEL_APPROVAL_TOKEN_SECRET=
SENTINEL_ADMIN_TOKEN=
LOCAL_SESSION_SIGNING_KEY=
ALERT_INGRESS_HMAC_KEY=

# Isolation boundaries
K8S_TARGET_NAMESPACE=demo-shop
K8S_SYSTEM_NAMESPACE=sentinel-system
K8S_OBSERVABILITY_NAMESPACE=observability
K8S_SCENARIO_NAMESPACE=sentinel-chaos

# Investigation defaults (hard limits are also enforced by policy)
INVESTIGATION_MAX_SECONDS=480
INVESTIGATION_MAX_LLM_CALLS=8
INVESTIGATION_MAX_TOOL_CALLS=20
INVESTIGATION_MAX_QUERY_MINUTES=30

# Local generated data
SENTINEL_DATA_DIR=.local/data
SENTINEL_ARTIFACTS_DIR=.local/artifacts
